---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

// A rest param, not `[slug]`: sidecar ids carry their type directory
// (`decision/foo`), so a single-segment route would not match any of them.
export async function getStaticPaths() {
  const sidecars = await getCollection('sidecars');
  return sidecars.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} · ai-coding-journey`} description={entry.data.summary}>
  <p class="back"><a href="/sidecars/">← sidecars</a></p>
  <dl class="meta">
    <div><dt>type</dt><dd>{entry.data.type}</dd></div>
    <div><dt>topic</dt><dd><a href={`/topics/${entry.data.topic}/`}>{entry.data.topic}</a></dd></div>
  </dl>
  <article><Content /></article>
</Base>

<style>
  .back { font-family: var(--font-mono); font-size: var(--size-0); margin: var(--space-4) 0 0; }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: var(--space-3) 0 0;
    padding: var(--space-3);
    background: var(--bg-sunk);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--size-0);
  }
  dt { color: var(--fg-dim); }
  dd { margin: 0; }
  article :global(h1:first-child) { margin-top: var(--space-4); }
</style>
