---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { makeStaticPaths } from '../../lib/entry-paths';

// A rest param, not `[slug]`: sidecar ids carry their type directory
// (`decision/foo`), so a single-segment route would not match any of them.
export const getStaticPaths = () => makeStaticPaths('sidecars');

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fields = [
  { label: 'type', value: d.type },
  { label: 'topic', value: d.topic, href: `/topics/${d.topic}/` },
];
---
<Entry
  title={d.title}
  description={d.summary}
  back={{ href: '/sidecars/', label: 'sidecars' }}
  fields={fields}
>
  <Content />
</Entry>
