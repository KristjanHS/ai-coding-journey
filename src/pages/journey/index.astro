---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import { MIN_COMMITS, experiments } from '../../lib/timeline';

const chapters = (await getCollection('journey')).sort((a, b) => a.id.localeCompare(b.id));

// The context ledger, one row per repo-backed chapter. The repo-less 90- band
// carries no ledger by construction (every key is `.optional()` for exactly that
// reason), so it is excluded rather than rendered as a row of blanks.
const LEDGER_FIELDS = [
  { key: 'could_see', label: 'could see', concern: 'Control' },
  { key: 'retrieved', label: 'retrieved', concern: 'Control' },
  { key: 'versioned', label: 'versioned', concern: 'Provenance' },
  { key: 'verified_by', label: 'verified by', concern: 'Quality' },
  { key: 'cost_to_look', label: 'cost to look', concern: 'Cost' },
] as const;

const ledgerRows = chapters.filter((entry) => entry.data.repo !== undefined);
---
<Base
  title="The journey · ai-coding-journey"
  description="One chapter per repo, from a 20-year coding pause to a ~5k-commit app built with AI agents."
>
  <h1>The journey</h1>
  <p class="lede">One chapter per repo, oldest first.</p>

  <Timeline variant="full" />

  <ol class="chapters">
    {chapters.map((entry) => (
      <li>
        <a href={`/journey/${entry.id}/`}>{entry.data.title}</a>
        {/* A non-repo chapter (90- band) carries none of the git-derived keys. */}
        {entry.data.stage && <span class="stage">{entry.data.stage}</span>}
        {entry.data.commits !== undefined && (
          <span class="commits">{entry.data.commits.toLocaleString('en-US')} commits</span>
        )}
        {entry.data.start && entry.data.end && (
          <span class="span">{entry.data.start} → {entry.data.end}</span>
        )}
      </li>
    ))}
  </ol>

  <h2>What the machine could see</h2>
  <p class="lede">
    Five fields per chapter, each drawn from a closed set, each read off the repo as it stood
    the fortnight it opened — not as it ended. The rung a repo reached later is its own key.
  </p>
  <div class="ledger-scroll">
    <table class="ledger">
      <thead>
        <tr>
          <th scope="col">chapter</th>
          {LEDGER_FIELDS.map((field) => (
            <th scope="col">
              {field.label}
              <span class="concern">{field.concern}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {ledgerRows.map((entry) => (
          <tr>
            <th scope="row"><a href={`/journey/${entry.id}/`}>{entry.data.title}</a></th>
            {LEDGER_FIELDS.map((field) => (
              <td>{entry.data[field.key] ?? <span class="unset">—</span>}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Also tried</h2>
  <p class="lede">Repos with fewer than {MIN_COMMITS} commits — no chapter of their own.</p>
  <ul class="experiments">
    {experiments.map((row) => (
      <li>
        <span class="repo">{row.repo}</span>
        <span class="span">{row.first_commit}</span>
        <span class="commits">{row.commits} commits</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lede { color: var(--fg-dim); margin-top: 0; }
  .chapters, .experiments { list-style: none; padding: 0; }
  .chapters li, .experiments li {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 9rem 7rem auto;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--rule);
  }
  .stage, .commits, .span, .repo {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }
  .repo { color: var(--fg); }
  /* Six columns of hyphenated enum values do not fit a phone. Scroll the table
     rather than abbreviating it: the values are the vocabulary the rest of the
     site uses, and a legend would cost the reader a lookup on every cell. */
  .ledger-scroll { overflow-x: auto; }
  .ledger {
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--size-0);
    white-space: nowrap;
  }
  .ledger th, .ledger td {
    text-align: left;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--rule);
    font-weight: normal;
  }
  .ledger thead th { color: var(--fg); vertical-align: bottom; }
  .ledger tbody th { color: var(--fg); }
  .ledger td { color: var(--fg-dim); }
  .ledger .concern {
    display: block;
    color: var(--fg-dim);
    font-size: 0.85em;
  }
  .ledger .unset { color: var(--fg-dim); }

  @media (max-width: 34rem) {
    .chapters li, .experiments li { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
