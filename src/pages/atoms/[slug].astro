---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { makeStaticPaths } from '../../lib/entry-paths';

export const getStaticPaths = () => makeStaticPaths('atoms');

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fields = [
  { label: 'rung', value: d.rung },
  { label: 'level', value: d.level },
  { label: 'evidence', value: d.evidence },
  { label: 'minutes', value: d.minutes },
  { label: 'audience', value: d.audience.join(', ') },
  { label: 'topic', value: d.topic, href: `/topics/${d.topic}/` },
];
---
<Entry title={d.title} back={{ href: '/atoms/', label: 'atoms' }} fields={fields}>
  <p class="question" slot="lead">{d.question}</p>
  <Content />
</Entry>

<style>
  .question { color: var(--fg-dim); max-width: 52ch; margin: var(--space-3) 0 0; }
</style>
