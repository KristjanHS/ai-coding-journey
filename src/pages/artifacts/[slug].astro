---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { makeStaticPaths } from '../../lib/entry-paths';

export const getStaticPaths = () => makeStaticPaths('artifacts');

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fields = [
  { label: 'kind', value: d.kind },
  { label: 'source', value: d.source },
  { label: 'captured', value: d.captured },
];
---
<Entry
  title={d.title}
  back={{ href: '/artifacts/', label: 'context artifacts' }}
  fields={fields}
  columnMin="12rem"
>
  <Content />
</Entry>
