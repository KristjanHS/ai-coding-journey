---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import { ARTIFACT_KINDS } from '../../content.config';

// Rows sort by the enum's declared order, not alphabetically: the six kinds are
// the page's argument, and `prompt` leading is the point it is arguing against.
const order = (kind: string) => ARTIFACT_KINDS.indexOf(kind as never);
const rows = (await getCollection('artifacts'))
  .sort((a, b) => order(a.data.kind) - order(b.data.kind) || a.id.localeCompare(b.id))
  .map((entry) => ({
    href: `/artifacts/${entry.id}/`,
    title: entry.data.title,
    meta: `${entry.data.kind} \u00b7 ${entry.data.captured}`,
  }));
---
<Base
  title="Context artifacts · ai-coding-journey"
  description="Six kinds of thing you put in front of a model: a prompt, a rule, a skill, a hook, a memory entry, a settings file."
>
  <SectionIndex
    title="Context artifacts"
    lede="A prompt is one of six kinds of thing you put in front of a model — the others are a rule file with its paths gate, a skill, a hook, a memory entry and a settings file. Reproduced as written."
    rows={rows}
    empty="No artifacts published yet."
  />
</Base>
