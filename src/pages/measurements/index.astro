---
// inc5a D3: ONE bespoke /measurements/ route, hand-written like /journey/. No [slug]
// detail route and no generated list route — every figure is read from the typed lib,
// which reads the generated eras.json. Server-rendered, no client JS, no island.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  TIME_DOMAIN,
  caveats,
  costStates,
  crossCheck,
  dateFraction,
  eraSpans,
  eras,
  overlapLabel,
  overlappingPairs,
  sttFaster,
  tokenHeadline,
} from '../../lib/measurements';

const nf = (n: number) => n.toLocaleString('en-US');
const pct = (d: string) => (dateFraction(d) * 100).toFixed(2);

// Group → colour, reusing the stage ramp tokens (D5: colour is the ONLY thing group
// controls; the five lanes never collapse to three).
const GROUP_COLOUR: Record<string, string> = {
  'vscode-plugin': 'var(--stage-chat)',
  cursor: 'var(--stage-config-engineering)',
  'claude-code': 'var(--stage-production-app)',
};

// D3: the citable narrative is one content/measurements/*.md per era, linked from
// this bespoke index (no [slug] route). Markdown-first — the entries read on GitHub
// as the product, so the link points at the public source file.
const narratives = (await getCollection('measurements')).sort((a, b) => a.id.localeCompare(b.id));
const GH = 'https://github.com/KristjanHS/ai-coding-journey/blob/main/content/measurements';

const provenanceById = new Map(eras.map((e) => [e.id, e.provenance]));
const crossById = new Map(crossCheck.map((c) => [c.id, c]));
// Caveats are not a section of their own any more — each line rides in the note column
// of the table it qualifies, so a figure can never be read without its qualifier.
const caveatsById = new Map(caveats.map((c) => [c.id, c.lines]));
---
<Base
  title="The numbers · ai-coding-journey"
  description="Measured token, cost and session evidence across five overlapping AI-coding tool eras — floors and absences named, never estimated."
>
  <h1>The numbers</h1>
  <p class="lede">
    Five AI-coding tools, measurable to wildly different depths — and they <em>overlap</em> in time, not
    a tidy succession. Every figure below is a floor or a named absence; nothing absent is estimated.
  </p>

  <!-- Overlap view: five lanes, ONE shared time axis. Bands positioned from the real
       dates against TIME_DOMAIN. data-overlap names the intersecting pairs. -->
  <h2>Overlapping eras</h2>
  <p class="lede">
    One time axis, one lane per era. Where lanes cover the same column, the tools overlapped —
    <code>{overlappingPairs.length}</code> pairs do.
  </p>
  <div class="axis" data-overlap={overlapLabel}>
    {eraSpans.map((span) => {
      const cross = crossById.get(span.id)!;
      const colour = GROUP_COLOUR[span.group];
      return (
        <div class="lane">
          <span class="lane-label">{span.tool}</span>
          <div class="track">
            {/* log range — the primary measured span */}
            <span
              class="band band-log"
              style={`left:${pct(cross.logStart)}%; right:${(100 - Number(pct(cross.logEnd))).toFixed(2)}%; background:${colour};`}
              title={`logs ${cross.logStart} → ${cross.logEnd}`}
            />
            {/* git range — offset, so a disagreement with the logs is visible, not smoothed */}
            {cross.gitStart && cross.gitEnd && (
              <span
                class="band band-git"
                style={`left:${pct(cross.gitStart)}%; right:${(100 - Number(pct(cross.gitEnd))).toFixed(2)}%; border-color:${colour};`}
                title={`config commits ${cross.gitStart} → ${cross.gitEnd}`}
              />
            )}
          </div>
        </div>
      );
    })}
    <div class="axis-scale">
      <span>{TIME_DOMAIN[0]}</span>
      <span>{TIME_DOMAIN[1]}</span>
    </div>
  </div>
  <p class="note">
    Overlapping pairs: <code>{overlapLabel}</code>.
  </p>
  <p>
    Two bands per lane, because two independent records exist and they disagree. The
    <strong>solid</strong> band is the <em>log</em> range — the first and last timestamp in that tool's own
    session files still on this machine. The <strong>outline</strong> band is the <em>config-commit</em>
    range — first to last commit touching that tool's config directory. Neither band is an adoption
    date: Claude Code's solid band sits at the far right, six weeks inside its own outline band, because
    that is where its surviving transcripts start. Both records are shown; neither is reconciled.
  </p>
  <table class="sources">
    <thead>
      <tr><th>tool</th><th>what the log actually is</th><th class="num">log range</th><th class="num">config commits</th></tr>
    </thead>
    <tbody>
      {eras.map((e) => {
        const cross = crossById.get(e.id)!;
        return (
          <tr>
            <td>
              <span class="dot" style={`background:${GROUP_COLOUR[e.group]};`} /> {e.tool}
            </td>
            <td class="cell-note">{provenanceById.get(e.id)!.logs}</td>
            <td class="num">{cross.logStart} → {cross.logEnd}</td>
            <td class="num">
              {cross.gitStart ? <>{cross.gitStart} → {cross.gitEnd}</> : <span class="empty">none — a genuine absence</span>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <!-- Token headline: a FLOOR over the four token-bearing tools (D2 as amended).
       One table — the qualifiers live in the note column, never in a prose paragraph. -->
  <h2>Token headline</h2>
  <p class="headline">
    <strong>{tokenHeadline.qualifier} {nf(tokenHeadline.floor)}</strong> tokens
    <span class="qual">· {tokenHeadline.bearingCount} of {tokenHeadline.totalTools} tools log any</span>
  </p>
  <table class="tokens">
    <thead>
      <tr>
        <th>tool</th><th>state</th><th class="num">headline tokens</th>
        <th class="num">cacheRead (reuse)</th><th>what qualifies it</th>
      </tr>
    </thead>
    <tbody>
      {tokenHeadline.contributions.map((c) => (
        <tr>
          <td>{c.tool}</td>
          <td><code>{c.state}</code></td>
          <td class="num">
            {c.sides ? (
              <>
                {nf(c.sides.main.headline)} <span class="qual">main</span><br />
                {nf(c.sides.mainPlusSubagent.headline)} <span class="qual">+ subagents</span>
              </>
            ) : (
              nf(c.headline)
            )}
          </td>
          <td class="num">{nf(c.cacheRead)}</td>
          <td class="cell-note">
            {c.cachedInputSubset ? (
              <span>{nf(c.cachedInputSubset)} cached-input tokens are a subset of input — shown, never added.<br /></span>
            ) : null}
            {(caveatsById.get(c.id) ?? []).map((line) => <span>{line}<br /></span>)}
            {c.sides ? <span>Both sides are counted; the floor above uses main + subagents.</span> : null}
          </td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <th>floor · main + subagents</th>
        <th><code>≥</code></th>
        <th class="num">{nf(tokenHeadline.floor)}</th>
        <th class="num">{nf(tokenHeadline.cacheRead)}</th>
        <th class="cell-note">
          Sum of <code>input + cacheCreation + output</code>. <code>cacheRead</code> is reuse and
          never enters the headline.
        </th>
      </tr>
      <tr>
        <th>floor · main sessions only</th>
        <th><code>≥</code></th>
        <th class="num">{nf(tokenHeadline.floorMain)}</th>
        <th class="num">—</th>
        <th class="cell-note">Claude Code subagent traffic excluded.</th>
      </tr>
    </tfoot>
  </table>

  <!-- Cost: four typed states (D4), each phrased in its own terms, never flattened. -->
  <h2>Cost — four states, never flattened</h2>
  <table class="costs">
    <thead>
      <tr><th>tool</th><th>state</th><th class="num">USD</th><th>what that state means here</th></tr>
    </thead>
    <tbody>
      {costStates.map((row) => (
        <tr>
          <td>
            <span class="dot" style={`background:${GROUP_COLOUR[eras.find((e) => e.id === row.id)!.group]};`} /> {row.tool}
          </td>
          <td><code>{row.state}</code></td>
          <td class="num">{row.usd !== null ? <span class="usd">${nf(Math.round(row.usd))}</span> : <span class="empty">—</span>}</td>
          <td class="cell-note">{row.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <!-- stt-faster experimentation corpus. -->
  <h2>stt-faster corpus</h2>
  <p class="note">
    A generation count, not a benchmark ({sttFaster.schemaSampledFrom} file schema-probed):
    <code>{sttFaster.batTotal}</code> <code>.bat</code> generations
    ({Object.entries(sttFaster.batGenerations).map(([k, v]) => `${k}:${v}`).join(' · ')}),
    files <code>{Object.entries(sttFaster.files).map(([k, v]) => `${k}:${v}`).join(' · ')}</code>.
    <code>failed/</code> is empty; superseded: <code>{sttFaster.supersededGenerations.join(', ')}</code>.
    Corpus mtimes {sttFaster.mtimeStart} → {sttFaster.mtimeEnd} sit inside the repo's git span
    {sttFaster.repo.gitStart} → {sttFaster.repo.gitEnd} — both shown, not reconciled.
  </p>

  <!-- D3: the citable narratives, one .md per era, linked to their GitHub source. -->
  <h2>Citable narratives</h2>
  <p class="lede">
    One entry per era — the single source every chapter, slide and post cites, so a figure is
    never typed twice.
  </p>
  <ul class="narratives">
    {narratives.map((entry) => (
      <li>
        <a href={`${GH}/${entry.id}.md`}>{entry.data.title}</a>
        {entry.data.summary && <span class="summary">{entry.data.summary}</span>}
      </li>
    ))}
  </ul>
</Base>

<style>
  .lede { color: var(--fg-dim); margin-top: 0; }
  .note { color: var(--fg-dim); font-size: var(--size-0); }
  code { background: var(--bg-sunk); border-radius: var(--radius); padding: 0 0.25em; }

  /* Overlap axis: one lane per era, all sharing the same horizontal time scale. */
  .axis { margin: var(--space-3) 0; }
  .lane {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-1) 0;
  }
  .lane-label {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .track { position: relative; height: 1.4rem; background: var(--bg-sunk); border-radius: var(--radius); }
  .band { position: absolute; border-radius: var(--radius); }
  .band-log { top: 0.15rem; height: 0.5rem; }
  .band-git { bottom: 0.15rem; height: 0.5rem; border: 1.5px solid; background: transparent; }
  .axis-scale {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-1);
    margin-left: calc(9rem + var(--space-2));
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }

  .headline { font-size: var(--size-3); margin: var(--space-2) 0; }
  .headline strong { color: var(--accent); }
  .qual { font-family: var(--font-mono); font-size: var(--size-0); color: var(--fg-dim); }

  table { border-collapse: collapse; width: 100%; margin: var(--space-2) 0; font-size: var(--size-0); }
  th, td { text-align: left; padding: var(--space-1) var(--space-2); border-bottom: 1px solid var(--rule); }
  th { font-family: var(--font-mono); color: var(--fg-dim); font-weight: normal; }
  td.num, .num { font-family: var(--font-mono); text-align: right; }
  .empty { color: var(--fg-dim); }
  .dot { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 50%; vertical-align: middle; }

  .usd { color: var(--accent); font-family: var(--font-mono); }
  .cell-note { color: var(--fg-dim); font-size: var(--size-0); line-height: 1.45; }
  .sources td.num, tfoot .num { white-space: nowrap; }
  tfoot th { font-weight: 600; color: var(--fg); border-top: 1px solid var(--rule); vertical-align: top; }
  td, th { vertical-align: top; }

  .narratives { list-style: none; padding: 0; }
  .narratives li { padding: var(--space-2) 0; border-bottom: 1px solid var(--rule); }
  .narratives a { font-weight: 600; }
  .summary { display: block; color: var(--fg-dim); font-size: var(--size-0); margin-top: var(--space-1); }

  table { display: block; overflow-x: auto; }

  @media (max-width: 34rem) {
    .lane { grid-template-columns: 6rem 1fr; }
    .axis-scale { margin-left: calc(6rem + var(--space-2)); }
  }
</style>
