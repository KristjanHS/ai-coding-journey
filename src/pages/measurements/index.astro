---
// inc5a D3: ONE bespoke /measurements/ route, hand-written like /journey/. No [slug]
// detail route and no generated list route — every figure is read from the typed lib,
// which reads the generated eras.json. Server-rendered, no client JS, no island.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  TIME_DOMAIN,
  dateFraction,
  eraSpans,
  eras,
  overlapLabel,
  governance,
  governanceRows,
  overlappingPairs,
  skills,
  tokenShape,
} from '../../lib/measurements';

const share = (n: number) => `${(n * 100).toFixed(n < 0.01 ? 2 : 1)}%`;
const pct = (d: string) => (dateFraction(d) * 100).toFixed(2);

// Group → colour, reusing the stage ramp tokens (D5: colour is the ONLY thing group
// controls; the lanes never collapse to their groups).
const GROUP_COLOUR: Record<string, string> = {
  chat: 'var(--stage-asking)',
  'vscode-plugin': 'var(--stage-delegating)',
  cursor: 'var(--stage-configuring)',
  gemini: 'var(--stage-suggesting)',
  'claude-code': 'var(--stage-governing)',
};

// D3: the citable narrative is one content/measurements/*.md per era, linked from
// this bespoke index (no [slug] route). Markdown-first — the entries read on GitHub
// as the product, so the link points at the public source file.
const narratives = (await getCollection('measurements')).sort((a, b) => a.id.localeCompare(b.id));
const GH = 'https://github.com/KristjanHS/ai-coding-journey/blob/main/content/measurements';
---
<Base
  title="The numbers · ai-coding-journey"
  description="What six overlapping AI-coding eras recorded about themselves — states, dates and relative shares. Absolute volumes are withheld by policy."
>
  <h1>The numbers</h1>
  <p class="lede">
    <code>{eras.length}</code> AI-coding eras, measurable to wildly different depths — one of them not
    at all — and they <em>overlap</em> in time, not a tidy succession. Nothing absent is estimated, and
    nothing present is a total: this page publishes <strong>states, dates and relative shares</strong>
    only.
  </p>

  <!-- Overlap view: one lane per era, ONE shared time axis. Bands positioned from the real
       dates against TIME_DOMAIN. data-overlap names the intersecting pairs. -->
  <h2>Overlapping eras</h2>
  <p class="lede">
    One time axis, one lane per tool, each bar spanning that tool's measured life. Where two bars
    share a column, both tools were in use in the same weeks —
    <code>{overlappingPairs.length}</code> pairs do, and not one of the
    <code>{eras.length}</code> eras is a clean succession. That is the finding: adopting a new tool
    never retired the previous one. The ends of each bar come from the tool's own records; the first
    bar is the exception its badge marks — the chat era left no record on this machine, so its span
    is a <strong>bracket</strong> between the earliest thread citing a dated artifact and the export
    that carried the threads off.
  </p>
  <div class="axis" data-overlap={overlapLabel}>
    {eraSpans.map((span) => (
      <div class="lane">
        <span class="lane-label">
          {span.tool}
          {span.dateMethod === 'estimated' && <span class="badge">est.</span>}
        </span>
        <div class="track">
          <span
            class="band"
            style={`left:${pct(span.barStart)}%; right:${(100 - Number(pct(span.end))).toFixed(2)}%; background:${GROUP_COLOUR[span.group]};`}
            title={`${span.barStart} → ${span.end} (${span.dateMethod})`}
            data-date-method={span.dateMethod}
          />
          {span.onset && (
            <span
              class="record-start"
              style={`left:${pct(span.start)}%;`}
              title={`the records only start ${span.start} — ${span.onsetLeadDays} days after the first token on ${span.onset}`}
            />
          )}
        </div>
      </div>
    ))}
    <div class="axis-scale">
      <span>{TIME_DOMAIN[0]}</span>
      <span>{TIME_DOMAIN[1]}</span>
    </div>
  </div>
  <p class="note">
    The Claude Code bar is one bar from that era's <em>real</em> start — its first billed token,
    <code>{eraSpans.find((s) => s.onset)?.onset}</code>, dated from a config field that survives log
    pruning. The tick inside it marks where the two records actually begin,
    {eraSpans.find((s) => s.onset)?.onsetLeadDays} days later; everything left of that tick is dated
    by the config field alone, because neither git nor a transcript reaches back that far. The gap is
    shown, not closed.
  </p>

  <!-- Token SHAPE: shares of a floor whose total is not published. The replacement for
       the old absolute headline — same finding (which tool dominated, and which cannot
       answer at all), none of the volume. -->
  <h2>Token shape</h2>
  <p class="lede">
    Which tool did the bulk of the work, and which cannot say. Each bar is that tool's share of the
    combined floor across the {tokenShape.bearingCount} tools that log tokens at all — a
    <em>relative</em> reading. The bars are log-scaled and the axis is deliberately unlabelled: they
    encode rank and rough spread, not quantity.
  </p>
  <table class="tokens">
    <thead>
      <tr>
        <th>tool</th><th class="num">share of the floor</th>
        <th>shape</th><th>what qualifies it</th>
      </tr>
    </thead>
    <tbody>
      {tokenShape.rows.map((row) => (
        <tr>
          <td>{row.tool}</td>
          <td class="num">
            {row.share !== null ? share(row.share) : <span class="empty">—</span>}
          </td>
          <td class="shape">
            {row.share !== null ? (
              <span class="bar" style={`width:${(row.logWidth * 100).toFixed(1)}%;`} />
            ) : (
              <span class="empty">no token field</span>
            )}
          </td>
          <td class="cell-note">{row.qualifier}</td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <th>the four that log any</th>
        <th class="num">{share(tokenShape.shareTotal)}</th>
        <th class="cell-note" colspan="2">
          The shares are of a floor, so the floor is a floor too — two of the four contribute one of
          their own. The floor's <em>value</em> is not published.
        </th>
      </tr>
    </tfoot>
  </table>

  <!-- inc5e: the two context dimensions no other generator reached (20 cross-session
       memory, 23 compaction handling), plus the skills block, which was measured and
       redacted from the first release and rendered nowhere until now. Every number is
       read from the lib; none is typed here. -->
  <h2>What the setup governed</h2>
  <p class="lede">
    Four counts of the configuration itself rather than of what it produced — the gates a session
    has to run, the notes it can carry between sessions, and the instructions it loads. They are a
    snapshot of one workstation, not a series: hooks and per-project memory did not exist before the
    Claude Code era, so there is nothing earlier to compare them against.
  </p>
  <table class="tokens">
    <thead>
      <tr><th>what</th><th class="num">count</th><th>what qualifies it</th></tr>
    </thead>
    <tbody>
      {governanceRows.map((row) => (
        <tr>
          <td>{row.label}</td>
          <td class="num">{row.value}</td>
          <td class="cell-note">{row.qualifier}</td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <th colspan="3" class="cell-note">{governance?.caveat} {skills?.caveat}</th>
      </tr>
    </tfoot>
  </table>

  <!-- D3: the citable narratives, one .md per era, linked to their GitHub source. -->
  <h2>Citable narratives</h2>
  <p class="lede">
    Every figure on this page is derived, and each era's derivation is written up once, in the file
    linked below — what was counted, what the tool's own records could and could not answer, and what
    stays unpublished. Chapters, slides and posts cite these files rather than retyping a number, so
    a figure has exactly one source. Read one when you want to check a bar on this page, or reuse a
    figure and need its qualifiers with it.
  </p>
  <table class="narratives">
    <thead>
      <tr><th>entry</th><th>what it covers</th></tr>
    </thead>
    <tbody>
      {narratives.map((entry) => (
        <tr>
          <td><a href={`${GH}/${entry.id}.md`}>{entry.data.title}</a></td>
          <td class="cell-note">{entry.data.summary}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>

<style>
  .lede { color: var(--fg-dim); margin-top: 0; }
  .note { color: var(--fg-dim); font-size: var(--size-0); }
  /* The estimated/measured badge. Read from `dateMethod`, never from a literal — an
     estimate that rendered like a measurement would be the page's worst possible bug. */
  .badge {
    font-family: var(--font-mono);
    font-size: var(--size--1, 0.75rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0 0.35em;
    color: var(--fg-dim);
  }
  .badge[data-date-method='estimated'] {
    border-style: dashed;
    color: var(--stage-asking);
  }
  .band[data-date-method='estimated'] { opacity: 0.55; }
  code { background: var(--bg-sunk); border-radius: var(--radius); padding: 0 0.25em; }

  /* Overlap axis: one lane per era, all sharing the same horizontal time scale. */
  .axis { margin: var(--space-3) 0; }
  .lane {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-1) 0;
  }
  .lane-label {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .track { position: relative; height: 1.4rem; background: var(--bg-sunk); border-radius: var(--radius); }
  .record-start {
    position: absolute; top: 0.1rem; height: 1.2rem; width: 2px;
    background: var(--stage-governing); transform: translateX(-1px);
  }
  .band { position: absolute; top: 0.3rem; height: 0.8rem; border-radius: var(--radius); }
  .axis-scale {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-1);
    margin-left: calc(9rem + var(--space-2));
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }

  .headline { font-size: var(--size-3); margin: var(--space-2) 0; }
  .headline strong { color: var(--accent); }
  .qual { font-family: var(--font-mono); font-size: var(--size-0); color: var(--fg-dim); }

  table { border-collapse: collapse; width: 100%; margin: var(--space-2) 0; font-size: var(--size-0); }
  th, td { text-align: left; padding: var(--space-1) var(--space-2); border-bottom: 1px solid var(--rule); }
  th { font-family: var(--font-mono); color: var(--fg-dim); font-weight: normal; }
  td.num, .num { font-family: var(--font-mono); text-align: right; }
  .empty { color: var(--fg-dim); }

  /* Log-scaled, deliberately unlabelled: rank and rough spread, never a quantity. */
  .shape { width: 30%; min-width: 6rem; }
  .bar {
    display: block;
    height: 0.7rem;
    border-radius: var(--radius);
    background: var(--accent);
    min-width: 2px;
  }
  .cell-note { color: var(--fg-dim); font-size: var(--size-0); line-height: 1.45; }
  tfoot .num { white-space: nowrap; }
  /* The tool name is the row's identity — never let it wrap to three lines. */
  .tokens td:first-child { white-space: nowrap; }
  tfoot th { font-weight: 600; color: var(--fg); border-top: 1px solid var(--rule); vertical-align: top; }
  td, th { vertical-align: top; }

  .narratives a { font-weight: 600; }

  table { display: block; overflow-x: auto; }

  @media (max-width: 34rem) {
    .lane { grid-template-columns: 6rem 1fr; }
    .axis-scale { margin-left: calc(6rem + var(--space-2)); }
  }
</style>
