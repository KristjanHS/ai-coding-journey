---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';

// Counts are derived at build time from the collections themselves, so a door
// can never advertise rows it does not have.
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const journey = await getCollection('journey');

// inc8 Stage 2. Nine rows became three doors because the nine were never peers:
// the corpus is the storage mechanism, the site and the deck are outputs served
// from it, and a flat list hid that while splitting single stories across rows
// (`case-study` is chapter 13 expanded; `course` is the deck delivered).
//
// The count rule from inc5a survives verbatim and for the same reason: a door
// with no entries is not a link and says why it is empty in its own words. The
// branch is on the count, never on the door's identity.
//
// `inside` is what keeps the collapse honest. Every route dissolved into a door
// stays one click from here, so nothing became an orphan -- `tests/nav.test.ts`
// is the executable form of that promise. `/course/` in particular has nowhere
// else to be linked from: `/deck/` is the offline slide runtime, and
// `tests/deck-offline.test.ts` fails the build on any root-absolute href there.
const sections = [
  {
    href: '/journey/',
    title: 'The journey',
    blurb: 'One chapter per repo, oldest first.',
    count: journey.length,
    unit: ['chapter', 'chapters'] as const,
    whenEmpty: 'none yet',
    inside: [
      { href: '/case-study/', label: 'the case study' },
      { href: '/measurements/', label: 'the numbers' },
    ],
  },
  {
    href: '/corpus/',
    title: 'The corpus',
    blurb: 'The storage layer every output is assembled from, not written beside.',
    count:
      (await getCollection('topics')).length +
      (await getCollection('atoms')).length +
      (await getCollection('sidecars')).length +
      (await getCollection('artifacts')).length,
    unit: ['entry', 'entries'] as const,
    whenEmpty: 'arrives at inc7',
    inside: [
      { href: '/topics/', label: 'topics' },
      { href: '/atoms/', label: 'atoms' },
      { href: '/sidecars/', label: 'sidecars' },
      { href: '/artifacts/', label: 'context artifacts' },
    ],
  },
  {
    // inc6: the count is the number of chapters that opted in via `deck: true`,
    // not the chapter total -- the deck is a selection, and a link claiming all
    // 15 would advertise slides that are not there.
    href: '/deck/',
    title: 'The deck',
    blurb: 'The lecture, from the chapters that opted in. Opens offline.',
    count: journey.filter((entry) => entry.data.deck).length,
    unit: ['chapter', 'chapters'] as const,
    whenEmpty: 'arrives at inc6',
    inside: [{ href: '/course/', label: 'the course skeleton' }],
  },
].map((section) => ({
  ...section,
  live: section.count > 0,
  label: section.count > 0 ? plural(section.count, ...section.unit) : section.whenEmpty,
}));
---
<Base
  title="ai-coding-journey"
  description="From a 20-year coding pause to a ~5k-commit app built with AI coding agents."
>
  <h1>ai-coding-journey</h1>
  <p class="lede">
    From a 20-year coding pause to a ~5k-commit app built with AI coding agents — one chapter
    per repo, with the prompts, rules, hooks and defects that got it there.
  </p>

  <Timeline variant="compact" />

  <ul class="sections">
    {sections.map((section) => (
      <li>
        {section.live
          ? <a href={section.href}>{section.title}</a>
          : <span class="pending">{section.title}</span>}
        <span class="count">{section.label}</span>
        <span class="blurb">
          {section.blurb}
          <span class="inside">
            {'inside: '}
            {section.inside.map((child, i) => (
              <>
                {i > 0 && ' \u00b7 '}
                <a href={child.href}>{child.label}</a>
              </>
            ))}
          </span>
        </span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lede { color: var(--fg-dim); margin-top: 0; max-width: 52ch; }
  .sections { list-style: none; padding: 0; margin-top: var(--space-4); }
  .sections li {
    display: grid;
    grid-template-columns: minmax(9rem, auto) 9rem 1fr;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .count, .blurb { font-size: var(--size-0); color: var(--fg-dim); }
  .inside { display: block; margin-top: var(--space-1); }
  .inside a { color: var(--fg-dim); }
  .pending { color: var(--fg-dim); }
  .count { font-family: var(--font-mono); }
  @media (max-width: 34rem) {
    .sections li { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
