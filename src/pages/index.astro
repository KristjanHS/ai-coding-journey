---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';

// Counts are derived at build time from the collections themselves, so a
// section can never advertise rows it does not have. One rule covers all four:
// a section with no entries is not a link, and says why it is empty in its own
// words — "arrives at inc5" for the unwritten sections, "none yet" for the
// published ones. A live-looking link onto an empty index is the thing this
// avoids, so the branch is on the count, never on the section's identity.
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const sections = [
  {
    href: '/journey/',
    title: 'The journey',
    blurb: 'One chapter per repo, oldest first.',
    count: (await getCollection('journey')).length,
    unit: ['chapter', 'chapters'] as const,
    whenEmpty: 'none yet',
  },
  {
    href: '/prompts/',
    title: 'Prompts',
    blurb: 'Reusable prompts, reproduced as they were typed.',
    count: (await getCollection('prompts')).length,
    unit: ['prompt', 'prompts'] as const,
    whenEmpty: 'none yet',
  },
  {
    href: '/case-study/',
    title: 'Case study',
    blurb: 'The markdown layer of the app this ends at.',
    count: (await getCollection('case-study')).length,
    unit: ['page', 'pages'] as const,
    whenEmpty: 'arrives at inc5',
  },
  {
    href: '/course/',
    title: 'Course',
    blurb: 'Built from the same markdown.',
    count: (await getCollection('course')).length,
    unit: ['page', 'pages'] as const,
    whenEmpty: 'arrives at inc5',
  },
].map((section) => ({
  ...section,
  live: section.count > 0,
  label: section.count > 0 ? plural(section.count, ...section.unit) : section.whenEmpty,
}));
---
<Base
  title="ai-coding-journey"
  description="From a 20-year coding pause to a ~5k-commit app built with AI coding agents."
>
  <h1>ai-coding-journey</h1>
  <p class="lede">
    From a 20-year coding pause to a ~5k-commit app built with AI coding agents — one chapter
    per repo, with the prompts, rules and defects that got it there.
  </p>

  <Timeline variant="compact" />

  <ul class="sections">
    {sections.map((section) => (
      <li>
        {section.live
          ? <a href={section.href}>{section.title}</a>
          : <span class="pending">{section.title}</span>}
        <span class="count">{section.label}</span>
        <span class="blurb">{section.blurb}</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lede { color: var(--fg-dim); margin-top: 0; max-width: 52ch; }
  .sections { list-style: none; padding: 0; margin-top: var(--space-4); }
  .sections li {
    display: grid;
    grid-template-columns: minmax(9rem, auto) 9rem 1fr;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .count, .blurb { font-size: var(--size-0); color: var(--fg-dim); }
  .pending { color: var(--fg-dim); }
  .count { font-family: var(--font-mono); }
  @media (max-width: 34rem) {
    .sections li { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
