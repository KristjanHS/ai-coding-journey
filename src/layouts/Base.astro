---
// The site's whole design system for inc3: one token layer, inherited by every
// later stage. No component library, no nav chrome — that arrives with the deck.
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site">
      <a href="/">ai-coding-journey</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    /* type scale — 1.25 ratio off a fluid base */
    --font-body: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --size-0: 0.833rem;
    --size-1: 1rem;
    --size-2: 1.25rem;
    --size-3: 1.563rem;
    --size-4: 1.953rem;

    /* spacing scale */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 1rem;
    --space-4: 2rem;
    --space-5: 4rem;

    /* colour tokens — only these are redefined for dark */
    --fg: #16181d;
    --fg-dim: #5b6070;
    --bg: #fdfdfc;
    --bg-sunk: #f2f2ef;
    --rule: #e0e0da;
    --accent: #9a4b1f;

    --measure: 68ch;
    --radius: 3px;

    /* stage ramp — an ordinal progression chat -> production-app, used by the
       timeline island. Five NEW tokens, not a second colour system; the last
       one is --accent. Each clears 3:1 against --bg (WCAG non-text floor). */
    --stage-chat: #6b7280;
    --stage-local-llm: #3f7d8c;
    --stage-first-agent: #4f7a3a;
    --stage-config-engineering: #b07d2b;
    --stage-production-app: #9a4b1f;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e6e6e1;
      --fg-dim: #9a9ba6;
      --bg: #14161a;
      --bg-sunk: #1c1f25;
      --rule: #2c3038;
      --accent: #e8956a;

      --stage-chat: #9aa0ad;
      --stage-local-llm: #5fa8b8;
      --stage-first-agent: #7bb060;
      --stage-config-engineering: #d6a24e;
      --stage-production-app: #e8956a;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }

  /* The one global a11y utility: content that is read but not drawn. The
     timeline's canonical non-visual reading is a table hidden this way. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  body {
    margin: 0;
    padding: 0 var(--space-3) var(--space-5);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--size-1);
    line-height: 1.6;
  }

  main { max-width: var(--measure); margin: 0 auto; }

  .site {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--size-0);
  }

  a { color: var(--accent); }
  .site a { color: var(--fg-dim); text-decoration: none; }
  .site a:hover { color: var(--accent); }

  h1 { font-size: var(--size-4); line-height: 1.2; margin: var(--space-5) 0 var(--space-3); }
  h2 { font-size: var(--size-2); margin: var(--space-4) 0 var(--space-2); }
  h3 { font-size: var(--size-1); margin: var(--space-3) 0 var(--space-1); }

  code, pre { font-family: var(--font-mono); font-size: var(--size-0); }
  pre {
    background: var(--bg-sunk);
    border-radius: var(--radius);
    padding: var(--space-3);
    overflow-x: auto;
  }
  blockquote {
    margin: var(--space-3) 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--rule);
    color: var(--fg-dim);
  }
</style>
