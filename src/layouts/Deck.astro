---
// inc6 Stage 1: the deck deliberately does NOT extend Base.astro. Base's <style is:inline>
// is bundled by Astro into an absolute `/_astro/*.css` reference, which resolves to
// FILESYSTEM ROOT when `dist/deck/index.html` is opened from a USB stick and renders
// the deck unstyled on stage. Every asset here is inline; `tests/deck-offline.test.ts`
// fails on any absolute href/src that creeps back in.
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:inline>
      :root {
        --ink: #14171a;
        --paper: #fbfaf7;
        --muted: #5b6570;
        --rule: #d8d4cc;
        --accent: #8a4b1f;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body {
        background: var(--paper);
        color: var(--ink);
        font: 400 1rem/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      .slide {
        display: none;
        width: 100vw;
        height: 100vh;
        padding: 4vh 6vw;
        overflow: hidden;
        flex-direction: column;
        justify-content: center;
      }
      /* No script has run yet on first paint (and none runs at all if scripting is
         off): the first slide must be visible without the `current` class. */
      .slide:first-of-type { display: flex; }
      .slide.current { display: flex; }
      body.scripted .slide:first-of-type:not(.current) { display: none; }
      .slide h1 { font-size: 4.2vw; line-height: 1.15; margin: 0 0 0.4em; }
      .slide h2 { font-size: 3.2vw; line-height: 1.2; margin: 0 0 0.6em; color: var(--accent); }
      .slide p, .slide li { font-size: 1.8vw; line-height: 1.5; }
      .slide .subtitle { color: var(--muted); font-size: 1.6vw; }
      .slide pre {
        font-size: 1.3vw;
        line-height: 1.4;
        overflow-x: auto;
        background: #f2efe9;
        border: 1px solid var(--rule);
        padding: 0.8em 1em;
      }
      .slide code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .slide table { border-collapse: collapse; font-size: 1.4vw; }
      .slide th, .slide td { border: 1px solid var(--rule); padding: 0.3em 0.6em; text-align: left; }
      .slide blockquote {
        border-left: 3px solid var(--accent);
        margin: 0 0 1em;
        padding-left: 1em;
        color: var(--muted);
      }
      .deck-nav {
        position: fixed;
        right: 2vw;
        bottom: 2vh;
        display: flex;
        gap: 0.6em;
        align-items: center;
        color: var(--muted);
        font-size: 1.2vw;
      }
      .deck-nav button {
        font: inherit;
        color: inherit;
        background: transparent;
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 0.2em 0.7em;
        cursor: pointer;
      }
      /* Print is the handout AND the fallback when the room's browser misbehaves,
         so it renders EVERY slide -- one per page -- not just the current one.
         Same source, same stylesheet, two outputs. */
      @media print {
        html, body { height: auto; }
        .slide, .slide.current, body.scripted .slide:first-of-type:not(.current) {
          display: flex;
          width: 100%;
          height: auto;
          min-height: 0;
          padding: 1.5cm;
          break-after: page;
          page-break-after: always;
        }
        .slide:last-of-type { break-after: auto; page-break-after: auto; }
        .slide h1 { font-size: 28pt; }
        .slide h2 { font-size: 20pt; }
        .slide p, .slide li { font-size: 12pt; }
        .slide pre, .slide table { font-size: 9pt; }
        .deck-nav { display: none; }
      }
    </style>
  </head>
  <body>
    <slot />
    <p class="deck-nav">
      <button type="button" data-deck-prev aria-label="previous slide">&#8592;</button>
      <span data-deck-count>&#8203;</span>
      <button type="button" data-deck-next aria-label="next slide">&#8594;</button>
    </p>
    <!-- `is:inline` for the same reason the stylesheet carries it: a bundled script
         is emitted as `/_astro/*.js`, an absolute path that resolves to filesystem
         root from a USB stick, and the deck loses its arrow keys on stage with no
         error anywhere. No framework, no router, no history API -- client-side
         routing is precisely what breaks under `file://`. -->
    <script is:inline>
      (function () {
        var slides = document.querySelectorAll('.slide');
        if (!slides.length) return;
        // The CSS shows slide 1 unscripted; `scripted` hands that job to `current`
        // so the two rules can never both paint a slide.
        document.body.classList.add('scripted');
        var count = document.querySelector('[data-deck-count]');
        var i = 0;
        function show(next) {
          i = Math.max(0, Math.min(slides.length - 1, next));
          for (var n = 0; n < slides.length; n++) {
            slides[n].classList.toggle('current', n === i);
          }
          if (count) count.textContent = i + 1 + ' / ' + slides.length;
        }
        document.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') show(i + 1);
          else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(i - 1);
          else if (e.key === 'Home') show(0);
          else if (e.key === 'End') show(slides.length - 1);
          else return;
          e.preventDefault();
        });
        var prev = document.querySelector('[data-deck-prev]');
        var next = document.querySelector('[data-deck-next]');
        if (prev) prev.addEventListener('click', function () { show(i - 1); });
        if (next) next.addEventListener('click', function () { show(i + 1); });
        show(0);
      })();
    </script>
  </body>
</html>
