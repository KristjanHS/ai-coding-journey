---
// Server half of the island: joins the generated rows to their chapter slugs
// and precomputes bar geometry, so Timeline.tsx stays a pure renderer.
import { getCollection } from 'astro:content';

import Timeline from './Timeline.tsx';
import type { TimelineBar, TimelineLane } from './Timeline.tsx';
import { TIME_DOMAIN, commitThickness, dateFraction, rows } from '../lib/timeline';
import { RUNG_PERIODS, livedThrough } from '../lib/rung-periods';

interface Props {
  variant: 'compact' | 'full';
}
const { variant } = Astro.props;

const hrefByRepo = new Map(
  (await getCollection('journey')).map((entry) => [entry.data.repo, `/journey/${entry.id}/`]),
);

// A one-day repo would otherwise render zero-width and read as missing data.
const MIN_WIDTH_PCT = 0.6;

const bars: TimelineBar[] = rows.map((row) => {
  const left = dateFraction(row.first_commit) * 100;
  return {
    repo: row.repo,
    stage: row.stage,
    commits: row.commits,
    first_commit: row.first_commit,
    last_commit: row.last_commit,
    left,
    width: Math.max(dateFraction(row.last_commit) * 100 - left, MIN_WIDTH_PCT),
    thickness: commitThickness(row.commits),
    // The rungs the repo was alive through, precomputed here so the island
    // stays a pure renderer: an open-ended period overlaps everything after it.
    lived: livedThrough(row.first_commit, row.last_commit),
    href: hrefByRepo.get(row.repo) ?? null,
  };
});

// The era strip. A rung with no measured end runs to the axis end, solid until
// its successor opens and fading to nothing after that: the fade is exactly the
// stretch where no log speaks. `governing` has no successor, so it stays solid.
const lanes: TimelineLane[] = RUNG_PERIODS.map((period, i) => {
  const next = RUNG_PERIODS[i + 1];
  const left = dateFraction(period.start) * 100;
  const right = period.end === null ? 100 : dateFraction(period.end) * 100;
  const width = Math.max(right - left, MIN_WIDTH_PCT);
  const solidRight = period.end !== null || !next ? right : dateFraction(next.start) * 100;
  return {
    rung: period.rung,
    start: period.start,
    startSource: period.startSource,
    end: period.end,
    endSource: period.endSource,
    left,
    width,
    // As a percentage of the LANE, not of the axis: the gradient stop is local.
    solidTo: Math.min(100, ((solidRight - left) / width) * 100),
    open: period.end === null,
    live: next === undefined,
  };
});

// One dashed vertical per rung start, dropped through every repo row. The
// `asking` start predates the first commit, so `dateFraction` clamps it to 0.
const seams = lanes.map((lane) => ({ rung: lane.rung, left: lane.left }));
---
<Timeline
  client:visible
  variant={variant}
  bars={bars}
  lanes={lanes}
  seams={seams}
  domain={[TIME_DOMAIN[0], TIME_DOMAIN[1]]}
/>

<style is:global>
  /* Global, not scoped: Astro's scoping attribute never reaches an island's
     client-rendered DOM, so every selector here is `tl-` prefixed instead. */
  .tl { margin: var(--space-4) 0; }
  .tl-row { display: grid; align-items: center; gap: var(--space-2); }
  .tl[data-variant='compact'] .tl-row { grid-template-columns: 1fr; }
  .tl[data-variant='full'] .tl-row { grid-template-columns: 9rem 1fr 7rem; }
  .tl-track { position: relative; height: 100%; }
  .tl-chart { position: relative; }

  /* The era strip. Lane rows mirror `.tl-row`'s grid but carry their own class:
     the bar-geometry test parses every `.tl-row` height as a repo row. */
  .tl-lane-row { display: grid; align-items: center; gap: var(--space-2); }
  .tl[data-variant='compact'] .tl-lane-row { grid-template-columns: 1fr; }
  .tl[data-variant='full'] .tl-lane-row { grid-template-columns: 9rem 1fr 7rem; }
  .tl-strip { margin-bottom: var(--space-2); padding-bottom: var(--space-2); border-bottom: 1px solid var(--rule); }
  .tl-lane { position: absolute; top: 50%; transform: translateY(-50%); border-radius: var(--radius); min-width: 2px; }
  .tl-lane-name, .tl-era-dates {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }
  .tl-era-dates { text-align: right; }
  /* Unlabelled coloured lanes are illegible, so compact names them in place. */
  .tl-lane-name.is-inline {
    position: absolute;
    top: 50%;
    transform: translate(2px, -50%);
    white-space: nowrap;
    pointer-events: none;
  }
  .tl-live { position: absolute; top: 50%; transform: translate(2px, -50%); color: var(--stage-governing); }

  /* Seams: one dashed vertical per rung start, through every repo row. */
  .tl-seams {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: stretch;
    gap: var(--space-2);
    pointer-events: none;
  }
  .tl[data-variant='compact'] .tl-seams { grid-template-columns: 1fr; }
  .tl[data-variant='full'] .tl-seams { grid-template-columns: 9rem 1fr 7rem; }
  .tl-seam {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed var(--rule);
  }
  /* The selected period, banded through every row. Translucent, so the bars
     under it keep their own ink and the band reads as a wash, not a block. */
  .tl-band-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--radius);
    background: var(--fg);
    opacity: 0.07;
  }
  /* The hit area spans the row's full height; the bar inside carries only the
     thickness, so neighbouring bars stay separated by the row gutter. */
  .tl-link, .tl-hit {
    position: absolute;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    min-width: 2px;
  }
  .tl-bar {
    width: 100%;
    border-radius: var(--radius);
    min-width: 2px;
  }
  .tl-label, .tl-count, .tl-axis {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }
  .tl-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl-count { text-align: right; }
  .tl-axis {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-1);
  }
  /* The legend IS the strip now: each lane's own name is its button. */
  .tl-lane-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    width: 100%;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tl-lane-btn[aria-pressed='true'] { border-color: var(--fg-dim); color: var(--fg); }
  .tl-row.is-dimmed { opacity: 0.22; }
  /* Hover is carried by an outline, not by colour: every bar is the one neutral
     ink, and a hue under the pointer would read as a rung the bar never claims. */
  .tl-row.is-hovered .tl-bar {
    outline: 1px solid var(--fg);
    outline-offset: 1px;
  }
  .tl-card { min-height: 1.4em; }
  .tl-card, .tl-status {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
    margin: var(--space-2) 0 0;
  }
  .tl-card strong { color: var(--fg); }
  .tl-swatch { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: var(--radius); }
  @media (max-width: 34rem) {
    .tl[data-variant='full'] .tl-row,
    .tl[data-variant='full'] .tl-lane-row,
    .tl[data-variant='full'] .tl-seams { grid-template-columns: 7rem 1fr; }
    .tl[data-variant='full'] .tl-count,
    .tl[data-variant='full'] .tl-era-dates { display: none; }
  }
</style>
