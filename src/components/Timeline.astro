---
// Server half of the island: joins the generated rows to their chapter slugs
// and precomputes bar geometry, so Timeline.tsx stays a pure renderer.
import { getCollection } from 'astro:content';

import Timeline from './Timeline.tsx';
import type { TimelineBar, TimelineLane } from './Timeline.tsx';
import { TIME_DOMAIN, chapters, commitThickness, dateFraction } from '../lib/timeline';
import { RUNG_PERIODS, livedThrough } from '../lib/rung-periods';

interface Props {
  variant: 'compact' | 'full';
}
const { variant } = Astro.props;

const hrefByRepo = new Map(
  (await getCollection('journey')).map((entry) => [entry.data.repo, `/journey/${entry.id}/`]),
);

// A lane can still be narrower than a hairline; bars cannot, since inc-era-labels
// demoted every one-day repo out of `chapters` and into the experiments list.
const MIN_WIDTH_PCT = 0.6;

// `chapters`, never `rows`: a repo that lived a single day is an experiment line
// (src/lib/timeline.ts::isChapter), and drawing it here as a hairline bar with no
// chapter behind it was the thing that read as missing data.
const bars: TimelineBar[] = chapters.map((row) => {
  const left = dateFraction(row.first_commit) * 100;
  return {
    repo: row.repo,
    stage: row.stage,
    commits: row.commits,
    first_commit: row.first_commit,
    last_commit: row.last_commit,
    left,
    width: Math.max(dateFraction(row.last_commit) * 100 - left, MIN_WIDTH_PCT),
    thickness: commitThickness(row.commits),
    // The rungs the repo was alive through, precomputed here so the island
    // stays a pure renderer: an open-ended period overlaps everything after it.
    lived: livedThrough(row.first_commit, row.last_commit),
    href: hrefByRepo.get(row.repo) ?? null,
  };
});

// The era strip. A rung with no measured end runs to the axis end, solid until
// its successor opens and fading to nothing after that: the fade is exactly the
// stretch where no log speaks. `governing` has no successor, so it stays solid.
const lanes: TimelineLane[] = RUNG_PERIODS.map((period, i) => {
  const next = RUNG_PERIODS[i + 1];
  const left = dateFraction(period.start) * 100;
  const right = period.end === null ? 100 : dateFraction(period.end) * 100;
  const width = Math.max(right - left, MIN_WIDTH_PCT);
  const solidRight = period.end !== null || !next ? right : dateFraction(next.start) * 100;
  return {
    rung: period.rung,
    start: period.start,
    startSource: period.startSource,
    end: period.end,
    endSource: period.endSource,
    left,
    width,
    // As a percentage of the LANE, not of the axis: the gradient stop is local.
    solidTo: Math.min(100, ((solidRight - left) / width) * 100),
    open: period.end === null,
    live: next === undefined,
  };
});

// One dashed vertical per rung start, dropped through every repo row. The
// `asking` start predates the first commit, so `dateFraction` clamps it to 0.
const seams = lanes.map((lane) => ({ rung: lane.rung, left: lane.left }));

// The era pills (compact). The old strip named each era by absolutely
// positioning grey text ON its own 6px lane, which is illegible at every width.
// The names now sit ABOVE the lanes as pills anchored at their era's start, and
// the rows are assigned GREEDILY here rather than by a hand-typed even/odd
// stagger: a pill takes the first row whose last occupant it clears, so a
// seventh rung would place itself instead of collapsing onto a neighbour.
//
// Width has to be ESTIMATED -- the server has no layout -- from the label's
// character count at the strip's mono size, as a percentage of an assumed track.
// Over-estimating is the safe direction: it buys an extra row, never an overlap.
const PILL_CHAR_PX = 7.2;
const PILL_CHROME_PX = 30;
const ASSUMED_TRACK_PX = 620;
const PILL_GAP_PCT = 1.5;

const pillWidthPx = (rung: string) => rung.length * PILL_CHAR_PX + PILL_CHROME_PX;
const pillWidth = (rung: string) => (pillWidthPx(rung) / ASSUMED_TRACK_PX) * 100;
// The pill is shifted left so its DOT sits on the seam, not its border: the
// same inset the CSS applies, as a percentage of the assumed track.
const PILL_INSET_PX = 12;
const PILL_INSET_PCT = (PILL_INSET_PX / ASSUMED_TRACK_PX) * 100;

// Right edge of the last pill placed on each row, in axis percent.
const rowEnds: number[] = [];

const pills = lanes.map((lane) => {
  const width = pillWidth(lane.rung);
  // A pill that would run off the right edge slides left only as far as it
  // must to stay on the track (the CSS clamps it the same way), so its dot
  // stays as near the seam as the page allows instead of flipping across it.
  const from = Math.min(lane.left, 100 - width) - PILL_INSET_PCT;
  const to = from + width;
  let row = rowEnds.findIndex((end) => from >= end + PILL_GAP_PCT);
  if (row === -1) row = rowEnds.push(0) - 1;
  rowEnds[row] = to;
  return { rung: lane.rung, left: lane.left, row, widthPx: pillWidthPx(lane.rung) };
});

const pillRows = rowEnds.length;
---
<Timeline
  client:visible
  variant={variant}
  bars={bars}
  lanes={lanes}
  seams={seams}
  pills={pills}
  pillRows={pillRows}
  domain={[TIME_DOMAIN[0], TIME_DOMAIN[1]]}
/>

<style is:global>
  /* Global, not scoped: Astro's scoping attribute never reaches an island's
     client-rendered DOM, so every selector here is `tl-` prefixed instead. */
  .tl { margin: var(--space-4) 0; }
  .tl-row { display: grid; align-items: center; gap: var(--space-2); }
  .tl[data-variant='compact'] .tl-row { grid-template-columns: 1fr; }
  .tl[data-variant='full'] .tl-row { grid-template-columns: 9rem 1fr 7rem; }
  .tl-track { position: relative; height: 100%; }
  .tl-chart { position: relative; }

  /* The era strip. Lane rows mirror `.tl-row`'s grid but carry their own class:
     the bar-geometry test parses every `.tl-row` height as a repo row. */
  .tl-lane-row { display: grid; align-items: center; gap: var(--space-2); }
  .tl[data-variant='compact'] .tl-lane-row { grid-template-columns: 1fr; }
  .tl[data-variant='full'] .tl-lane-row { grid-template-columns: 9rem 1fr 7rem; }
  .tl-strip { margin-bottom: var(--space-2); padding: var(--space-1) 0 var(--space-2); border-bottom: 1px solid var(--rule); }
  .tl-lane { position: absolute; top: 50%; transform: translateY(-50%); border-radius: var(--radius); min-width: 2px; }
  .tl-era-dates {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }
  .tl-era-dates { text-align: right; }

  /* The era pills (compact). Names sit ABOVE the lanes, never on them: grey text
     painted onto a 6px coloured lane was unreadable at every width. Each pill is
     anchored at its era's start and carries that era's colour as a dot, so the
     pill, the seam below it and the lane all say the same thing in one hue. */
  .tl-pills { position: relative; }
  /* Strip + chart in one positioned box, so the seams span both. */
  .tl-body { position: relative; }
  .tl-pill-row { position: relative; height: 1.5rem; }
  .tl-pill {
    position: absolute;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg-sunk);
    font-family: var(--font-mono);
    font-size: var(--size-0);
    line-height: 1.2;
    color: var(--fg);
    white-space: nowrap;
  }
  /* Anchored by the DOT, not the border: `--tl-pill-left` is the seam, the
     inset (border + padding + half a dot) pulls the pill back so the dot's
     centre lands on the 2px seam. `min()` clamps a pill that would overrun the
     track to its right edge instead of flipping it across its own seam. */
  .tl-pill {
    --tl-pill-inset: calc(0.75rem + 1px);
    left: min(var(--tl-pill-left), calc(100% - var(--tl-pill-w)));
    transform: translateX(calc(-1 * var(--tl-pill-inset)));
  }
  .tl-pill-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; flex: none; }
  /* Carries a pill on an upper row down to the strip: the same colour, so the
     eye follows one line from the name to the lane to the seam in the chart. */
  .tl-pill-drop {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px dashed;
    opacity: 0.7;
  }
  .tl-live { position: absolute; top: 50%; transform: translate(2px, -50%); color: var(--stage-governing); }

  /* Seams: one dashed vertical per rung start, through every repo row. */
  .tl-seams {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: stretch;
    gap: var(--space-2);
    pointer-events: none;
  }
  .tl[data-variant='compact'] .tl-seams { grid-template-columns: 1fr; }
  .tl[data-variant='full'] .tl-seams { grid-template-columns: 9rem 1fr 7rem; }
  /* Coloured by the rung it opens, not grey: the seam is the channel that
     carries an era ACROSS the repo rows, and a neutral line carried nothing. */
  .tl-seam {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px dashed var(--rule);
    opacity: 0.7;
  }
  /* The selected period, banded through every row. Translucent, so the bars
     under it keep their own ink and the band reads as a wash, not a block. */
  .tl-band-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--radius);
    background: var(--fg);
    opacity: 0.07;
  }
  /* The hit area spans the row's full height; the bar inside carries only the
     thickness, so neighbouring bars stay separated by the row gutter. */
  .tl-link, .tl-hit {
    position: absolute;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    min-width: 2px;
  }
  .tl-bar {
    width: 100%;
    border-radius: var(--radius);
    min-width: 2px;
  }
  .tl-label, .tl-count, .tl-axis {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
  }
  .tl-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl-count { text-align: right; }
  .tl-axis {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-1);
  }
  /* The legend IS the strip now: each lane's own name is its button. */
  .tl-lane-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    width: 100%;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tl-lane-btn[aria-pressed='true'] { border-color: var(--fg-dim); color: var(--fg); }
  .tl-row.is-dimmed { opacity: 0.22; }
  /* Hover is carried by an outline, not by colour: every bar is the one neutral
     ink, and a hue under the pointer would read as a rung the bar never claims. */
  .tl-row.is-hovered .tl-bar {
    outline: 1px solid var(--fg);
    outline-offset: 1px;
  }
  .tl-card { min-height: 1.4em; }
  .tl-card, .tl-status {
    font-family: var(--font-mono);
    font-size: var(--size-0);
    color: var(--fg-dim);
    margin: var(--space-2) 0 0;
  }
  .tl-card strong { color: var(--fg); }
  .tl-swatch { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: var(--radius); }
  @media (max-width: 34rem) {
    .tl[data-variant='full'] .tl-row,
    .tl[data-variant='full'] .tl-lane-row,
    .tl[data-variant='full'] .tl-seams { grid-template-columns: 7rem 1fr; }
    .tl[data-variant='full'] .tl-count,
    .tl[data-variant='full'] .tl-era-dates { display: none; }
  }
</style>
